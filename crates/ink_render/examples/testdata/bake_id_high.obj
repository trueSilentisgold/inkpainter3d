# Two flat quads just above bake_low.obj, in two materials: the left half (x < 0) and the
# right half, for ID maps and color selections.
mtllib bake.mtl
v -1 0.01 -1
v 0 0.01 -1
v 0 0.01 1
v -1 0.01 1
v 0 0.01 -1
v 1 0.01 -1
v 1 0.01 1
v 0 0.01 1
vn 0 1 0
o Left
usemtl Left
f 4//1 3//1 2//1 1//1
o Right
usemtl Right
f 8//1 7//1 6//1 5//1
